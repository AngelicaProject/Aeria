{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aeria",
  "identifier": "org.angelicaproject.aeria",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aeria",
        "width": 900,
        "height": 560,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/harmonia-atlas"
    ],
    "linux": {
      "deb": {
        "depends": ["git"]
      },
      "rpm": {
        "depends": ["git"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Angelica Project",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMUZFRjdGN0ZCQTc3QwpSV1I4cC92MzkvNnhEK1lTTEJRUTdlVlBwbFl0TUlsVjRIUjRGVkc1YVZyR1Zxb25Ua0pMZ2lTRwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
