{
  "name": "@aeria/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage \"--test-coverage-include=src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"tests/*.test.mjs\"",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
